{
  "name": "@originoneai/dsh-awr",
  "version": "0.2.0",
  "type": "module",
  "description": "Connects DeepSeek Harness to AWR (Agent Work Runtime) so a project's work state, claims and checkpoints survive across conversations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originoneai/dsh-awr.git"
  },
  "homepage": "https://github.com/originoneai/dsh-awr#readme",
  "bugs": {
    "url": "https://github.com/originoneai/dsh-awr/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "awr",
    "agent-work-runtime",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./awr-runtime": "./lib/awr-runtime.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "client.js"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
